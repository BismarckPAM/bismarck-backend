{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AnalyticsDatabase": "Host=localhost;Port=5439;Database=analytics_db;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "Issuer": "Identity.Service",
    "Audience": "Bismarck.Services",
    "SigningKey": ""
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "localhost:9092",
    "GroupId": "bismarck-analytics-service",
    "DeadLetterTopic": "analytics-dead-letter"
  },
  "PublicPaths": [
    "/health",
    "/swagger"
  ]
}
