# Use a resettable test deployment with the same gateway contracts as production.
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8080
E2E_DEV_EMAIL=
E2E_DEV_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# A SECOND ordinary account, distinct from the first developer and the Admin.
E2E_OTHER_EMAIL=
E2E_OTHER_PASSWORD=
# Required only for lifecycle + security projects. Use a dedicated NON-VM resource.
E2E_ALLOW_WRITES=false
E2E_RESOURCE_ID=
E2E_LEVEL=1
E2E_DURATION_MINUTES=5
E2E_ASYNC_TIMEOUT_MS=60000
