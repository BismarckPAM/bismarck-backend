{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",

  // Origins allowed to call the gateway from a browser. Override per environment
  // (e.g. AllowedOrigins__0 in Docker Compose). The React SPA's deployed URL
  // goes here before production.
  "AllowedOrigins": [
    "http://localhost:5173"
  ],

  // Paths the gateway lets through WITHOUT a token. The health probe is required
  // by container orchestrators; the login endpoint must be reachable before any
  // token exists. Everything else requires a well-formed JWT Bearer header.
  "PublicPaths": [
    "/health",
    "/api/identity/auth/login",
    "/swagger",
    "/api/identity/swagger"
  ],

  // Internal downstream URLs. Each entry is injected into the matching YARP
  // cluster destination at startup (see Program.cs). Values here are local-dev
  // defaults; override via Services__{Name}__Url for Docker Compose / Azure.
  "Services": {
    "identity": {
      "Url": "http://localhost:5080"
    },
    "resource": {
      "Url": "http://localhost:5039"
    }
  },

  // YARP reverse proxy config. Path-based routing: /api/identity/{**catch-all}
  // -> identity cluster, /api/resource/{**catch-all} -> resource cluster. The
  // full path is forwarded unchanged because each service is responsible for
  // its own /api/{service}/... route prefix (Identity's controllers already use
  // [Route("api/identity/...")]). To add a service: one route + one cluster +
  // one Services:{name}:Url entry — no code change.
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        }
      },
      "resource-route": {
        "ClusterId": "resource-cluster",
        "Match": {
          "Path": "/api/resources/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity": {
            "Address": "http://localhost:5080"
          }
        }
      },
      "resource-cluster": {
        "Destinations": {
          "resource": {
            "Address": "http://localhost:5039"
          }
        }
      }
    }
  }
}
