{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",

  "AllowedOrigins": [
    "https://frontend-ui.mangopond-f3cfcd27.southeastasia.azurecontainerapps.io"
  ],

  "PublicPaths": [
    "/health",
    "/api/identity/auth/login",
    "/swagger",
    "/api/identity/swagger"
  ],

  "Services": {
    "identity": {
      "Url": "http://localhost:5080"
    },
    "resource": {
      "Url": "http://localhost:5039"
    },
    "authorization": {
      "Url": "http://localhost:5280"
    },
    "approval": {
      "Url": "http://localhost:5131"
    },
    "audit": {
      "Url": "http://localhost:5211"
    },
    "notification": {
      "Url": "http://localhost:5100"
    }
  },

  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        }
      },
      "resource-base-route": {
        "ClusterId": "resource-cluster",
        "Match": {
          "Path": "/api/resources"
        }
      },
      "resource-route": {
        "ClusterId": "resource-cluster",
        "Match": {
          "Path": "/api/resources/{**catch-all}"
        }
      },
      "authorization-route": {
        "ClusterId": "authorization-cluster",
        "Match": {
          "Path": "/api/authorization/{**catch-all}"
        }
      },
      "approval-route": {
        "ClusterId": "approval-cluster",
        "Match": {
          "Path": "/api/approval/{**catch-all}"
        }
      },
      "audit-route": {
        "ClusterId": "audit-cluster",
        "Match": {
          "Path": "/api/audit/{**catch-all}"
        }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "policy-base-route": {
        "ClusterId": "authorization-cluster",
        "Match": {
          "Path": "/authz/policies"
        }
      },
      "policy-route": {
        "ClusterId": "authorization-cluster",
        "Match": {
          "Path": "/authz/policies/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity": {
            "Address": "http://localhost:5080"
          }
        }
      },
      "resource-cluster": {
        "Destinations": {
          "resource": {
            "Address": "http://localhost:5039"
          }
        }
      },
      "authorization-cluster": {
        "Destinations": {
          "authorization": {
            "Address": "http://localhost:5280"
          }
        }
      },
      "approval-cluster": {
        "Destinations": {
          "approval": {
            "Address": "http://localhost:5131"
          }
        }
      },
      "audit-cluster": {
        "Destinations": {
          "audit": {
            "Address": "http://localhost:5211"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification": {
            "Address": "http://localhost:5100"
          }
        }
      }
    }
  }
}
