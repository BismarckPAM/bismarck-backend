# Database Credentials
DB_USER=admin
DB_PASSWORD=MySecretPassword123

# Identity Database
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_PORT=5431

# Resource Database
RESOURCE_DB_NAME=resource_db
RESOURCE_DB_PORT=5432

# API Gateway — the only port meant to be reachable from outside the compose network
GATEWAY_PORT=8080

# Comma-separated / single origin allowed by the gateway's CORS policy
# (the React SPA's origin). Set to the deployed frontend URL before going live.
ALLOWED_ORIGINS=http://localhost:5173

JWT_SIGNING_KEY=ED!W4[MQ:=T<g/[L.k*Vyn<THpYg.bN^ec5kB^BB.7q

# ==========================================
# Kafka & Event Streaming Configuration
# ==========================================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EXTERNAL_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_PORT=29092
KAFKA_UI_PORT=8085
KAFKA_TEST_TOPIC=pam.test.events
