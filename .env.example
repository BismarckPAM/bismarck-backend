# Brokered JIT terminal (OPTIONAL - leave blank to disable the web terminal)
# ---------------------------------------------------------------------------
# Without a key here, GET /api/jit/terminal/{id}/status reports
# brokerConfigured=false and the UI hides the terminal button.
#
# WHICH ACCOUNT DOES THE BROKER LOG IN AS?
# By default it logs in as the JIT session's OWN user (the session's email),
# because that is the account Azure creates on the VM and the one the JIT role
# assignment authorises. This is what makes the in-browser terminal match the
# `ssh user@vm` command shown on screen. Set JIT_SSH_USERNAME only to force one
# shared account for every session (the legacy "azureuser" behaviour), or
# JIT_SSH_USERNAME_TEMPLATE to reshape the login (e.g. "{email}@pam").
JIT_SSH_USERNAME=
JIT_SSH_USERNAME_TEMPLATE=

# Fallback (shared) private key. Prefer the PATH form: mount the PEM as a
# read-only secret and point at it, which avoids the newline mangling that
# inline PEM suffers inside environment variables.
JIT_SSH_PRIVATE_KEY_PATH=/var/run/bismarck/ssh-keys/azureuser
# Inline PEM is also supported, with literal \n between lines.
JIT_SSH_PRIVATE_KEY=
# Only needed for an encrypted private key.
JIT_SSH_PASSPHRASE=
JIT_SSH_PORT=22

# Per-user keys. Put one PEM file per SSH login in this host directory, named
# after the login exactly (e.g. "user@example.com"); it is mounted read-only and
# JitSsh__PrivateKeyDirectory points inside the container. The broker picks the
# file matching the session's login, and only falls back to the shared key above.
JIT_SSH_PRIVATE_KEY_DIRECTORY=/var/run/bismarck/ssh-keys
JIT_SSH_KEYS_HOST_DIR=./jit-keys

# Optional but recommended: the VM host key fingerprint, as printed by
# `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub`. When set, the broker
# refuses to connect if the VM presents a different host key.
JIT_SSH_HOST_KEY_FINGERPRINT=
