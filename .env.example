# Database Credentials
DB_USER=admin
DB_PASSWORD=MySecretPassword123

# Identity Database
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_PORT=5431

# Resource Database
RESOURCE_DB_NAME=resource_db
RESOURCE_DB_PORT=5432

# Approval Database
APPROVAL_DB_NAME=approval_db
APPROVAL_DB_PORT=5436

# Authorization Database
AUTHORIZATION_DB_NAME=authorization_db
AUTHORIZATION_DB_PORT=5435

# Audit Database
AUDIT_DB_NAME=audit_db
AUDIT_DB_PORT=5437

# Notification Database
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_PORT=5438

# API Gateway — the only port meant to be reachable from outside the compose network
GATEWAY_PORT=8080

# Comma-separated / single origin allowed by the gateway's CORS policy
# (the React SPA's origin). Set to the deployed frontend URL before going live.
ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Azure JIT cloud provisioning (OPTIONAL - leave blank for local development)
# ---------------------------------------------------------------------------
# When all four of TENANT_ID / CLIENT_ID / CLIENT_SECRET / SUBSCRIPTION_ID are
# non-empty, AuthorizationService provisions a real Azure RBAC role assignment
# for each approved request. When they are blank it falls back to
# NoOpJitProvisioner: the JIT session is still created, tracked and auto-expired,
# but is recorded with ProvisioningStatus = LOCAL_ONLY instead of ACTIVE.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# Optional. Blank targets the whole subscription instead of a resource group.
AZURE_RESOURCE_GROUP=
# Optional. Only needed if the user's email is not linked to an Entra ID.
AZURE_PRINCIPAL_ID=

