<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The test projects live inside this folder (same layout as Approval,
         Notification and Analytics) and must never be compiled into the web
         service. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Audit.Service.Tests/**;Audit.Service.IntegrationTests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Audit.Service.Tests/**/*.cs" />
    <Compile Remove="Audit.Service.IntegrationTests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Confluent.Kafka" Version="2.15.1" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BuildingBlocks\Messaging\Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- BuildContainsPattern is internal so the unit suite can assert the LIKE
         wildcard escaping directly. -->
    <InternalsVisibleTo Include="Audit.Service.Tests" />
  </ItemGroup>

</Project>
